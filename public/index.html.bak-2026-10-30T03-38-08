/* Motion-only feedback; existing colours, type and geometry stay unchanged. */
a:not(.btn), button:not(.btn), .faq summary{
  transition: color .18s ease, transform .18s ease, opacity .18s ease;
}
a:not(.btn):hover, button:not(.btn):hover:not(:disabled){ transform: translateY(-1px); }
a:focus-visible, button:focus-visible, .faq summary:focus-visible{
  outline: 2px solid currentColor;
  outline-offset: 3px;
}
a:focus-visible, button:focus-visible, .btn:focus-visible{ transform: translateY(-1px); }
.field input, .field select{
  transition: border-color .18s ease, box-shadow .18s ease;
}
.car{ transition: transform .22s ease; }
.car-img img{ transition: transform .35s ease; }
@media (hover: hover) and (prefers-reduced-motion: no-preference) {
  .car:hover{ transform: translateY(-2px); }
  .car:hover .car-img img{ transform: scale(1.035); }
}
.modal-bg{
  display: flex;
  visibility: hidden;
  opacity: 0;
  pointer-events: none;
  transition: opacity .22s ease, visibility 0s linear .22s;
}
.modal-bg.show{
  visibility: visible;
  opacity: 1;
  pointer-events: auto;
  transition: opacity .22s ease, visibility 0s;
}
.modal{ transform: translateY(6px); transition: transform .22s ease; }
.modal-bg.show .modal{ transform: translateY(0); }
@media (prefers-reduced-motion: no-preference) {
  html.motion-ready .reveal{
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .45s ease, transform .45s ease;
  }
  html.motion-ready .reveal.is-visible{ opacity: 1; transform: translateY(0); }
}
@media (prefers-reduced-motion: reduce) {
  html{ scroll-behavior: auto; }
  *, *::before, *::after{
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-delay: 0ms !important;
    transition-duration: .01ms !important;
  }
}

